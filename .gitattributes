# Windows batch files must use CRLF line endings
*.bat text eol=crlf
*.ps1 text eol=crlf

# Authenticated captures and owned fixture bytes must not undergo EOL conversion.
tests/results/marker/** -text -whitespace
tests/fixtures/marker/** -text
# Preserve the attributed font notice, including its upstream trailing spaces.
tests/fixtures/marker/FONT-NOTICE.txt -whitespace
# These first-party model cards are retained verbatim with recorded SHA-256s.
# Preserve their original line endings and intentional Markdown line breaks.
licenses/latent-inpaint/moebius-weights-model-card.md -text whitespace=-blank-at-eol
licenses/latent-inpaint/moebius-upstream-README.md -text whitespace=-blank-at-eol
licenses/latent-inpaint/pixelhacker-weights-model-card.md -text whitespace=-blank-at-eol
licenses/latent-inpaint/sdxl-vae-model-card.md -text whitespace=-blank-at-eol
# Frozen contracts/receipts whose exact bytes are SHA-256 pinned by tools and
# tests: Windows autocrlf checkouts must not rewrite them (inpaint-cli Windows).
docs/*contract*.json -text
tests/results/migan/** -text
# Licence texts published byte for byte (docs/inpaint-publication-v1.json pins their SHA-256).
licenses/latent-inpaint/*.txt -text
licenses/latent-inpaint/NOTICE.md -text
# OvisOCR3 source audit retains the original CRLF license and Markdown bytes.
tests/fixtures/ovisocr3-document-source/** -text -whitespace
docs/ovisocr3-document-protocol.json -text
tests/results/qwen35-ocr/lightonocr3-4b-imatrix-adapter/v*/lighton-imatrix-results/bootstrap.log whitespace=-trailing-space
