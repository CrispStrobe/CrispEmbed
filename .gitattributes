# Windows batch files must use CRLF line endings
*.bat text eol=crlf
*.ps1 text eol=crlf

# Authenticated captures and owned fixture bytes must not undergo EOL conversion.
tests/results/marker/** -text -whitespace
tests/fixtures/marker/** -text
# Preserve the attributed font notice, including its upstream trailing spaces.
tests/fixtures/marker/FONT-NOTICE.txt -whitespace
