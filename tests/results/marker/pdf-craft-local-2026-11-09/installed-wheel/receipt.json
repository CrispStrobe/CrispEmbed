  "commands": [
    {
      "label": "build-wheel",
      "command": [
        "<PYTHON_RUNTIME>/bin/python3",
        "setup.py",
        "bdist_wheel",
        "--dist-dir",
        "<WORK>/wheelhouse"
      ],
      "returncode": 0
    },
    {
      "label": "create-venv",
      "command": [
        "<PYTHON_RUNTIME>/bin/python3",
        "-m",
        "venv",
        "--system-site-packages",
        "--without-pip",
        "<WORK>/consumer-venv"
      ],
      "returncode": 0
    },
    {
      "label": "install-wheel",
      "command": [
        "<PYTHON_RUNTIME>/bin/python3",
        "-m",
        "pip",
        "--python",
        "<WORK>/consumer-venv/bin/python",
        "install",
        "--no-index",
        "--no-deps",
        "<WORK>/wheelhouse/crispembed-0.17.16-cp312-cp312-linux_x86_64.whl"
      ],
      "returncode": 0
    },
    {
      "label": "installed-location",
      "command": [
        "<WORK>/consumer-venv/bin/python",
        "-I",
        "-c",
        "from pathlib import Path; import crispembed; print(Path(crispembed.__file__).resolve().parent)"
      ],
      "returncode": 0
    },
    {
      "label": "installed-real-pdf",
      "command": [
        "<WORK>/consumer-venv/bin/python",
        "-I",
        "-B",
        "<REPOSITORY>/tests/test_marker_real_pdf.py",
        "--installed-package",
        "--lib",
        "<WORK>/consumer-venv/lib/python3.12/site-packages/crispembed/libcrispembed.so",
        "--pdfium",
        "<PDFIUM>",
        "--out",
        "<OUTPUT>/real-pdf"
      ],
      "returncode": 0
    }
  ],
